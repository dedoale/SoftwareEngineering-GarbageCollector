<mxfile host="app.diagrams.net">
  <diagram name="Pagina-1" id="HASed8KyOPvUuR6jbAaz">
    <mxGraphModel dx="1333" dy="-273" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam packageStyle rectangle\n\n&#39; --- CONTROLLERS ---\npackage \&quot;Controllers (API Boundary)\&quot; {\n  class AuthController {\n    + loginSPID(token: String): Response\n  }\n  class SegnalazioneController {\n    + creaSegnalazione(dto: DTO): Response\n  }\n  class RoutingController {\n    + avviaOttimizzazione(turno: DateTime): Response\n  }\n  class NotificaController {\n    + inviaAvviso(testo: String, zona: String): Response\n  }\n}\n\n&#39; --- SERVICES ---\npackage \&quot;Services (Business Logic)\&quot; {\n  class AuthService {\n    + validaIdentita(token: String): Utente\n  }\n  class SegnalazioneService {\n    + processaNuovaSegnalazione(dati: DTO): Segnalazione\n    + checkDuplicati(gps: Coordinate): List&lt;Segnalazione&gt;\n  }\n  class IAPrivacyService {\n    + offuscaDatiSensibili(img: Foto): Foto\n  }\n  class RoutingService {\n    + calcolaPercorso(mezzi: List): PercorsoOttimizzato\n  }\n  class NotificaService {\n    + inviaPromemoriaAutomatici(): void\n  }\n}\n\n&#39; --- DOMAIN ENTITIES ---\npackage \&quot;Domain Entities\&quot; {\n\n  &#39; ENUMS\n  enum StatoSegnalazione {\n    IN_COMPILAZIONE\n    SOSPESA_OFFLINE\n    APERTA\n    IN_LAVORAZIONE\n    CHIUSA\n    RIFIUTATA\n  }\n  enum TipoNotifica {\n    PROMEMORIA\n    AVVISO_STRAORDINARIO\n  }\n  enum TipoRifiuto {\n    PLASTICA, CARTA, VETRO, ORGANICO, SECCO, SPECIALE\n  }\n\n  &#39; CLASSI\n  abstract class Utente {\n    # id: UUID\n    # email: String\n  }\n  class Cittadino {\n    - codiceFiscale: String\n    - ultimoInvio: DateTime\n  }\n  class OperatoreEcologico {\n    - matricola: String\n  }\n  \n  class Segnalazione {\n    - id: UUID\n    - coordinateGPS: Coordinate\n    + aggiornaStato(): void\n  }\n  class Foto {\n    - pathGrezza: String\n    - pathOffuscata: String\n  }\n  \n  class Cassonetto {\n    - id: String\n    - gps: Coordinate\n    - capacitaMax: int\n  }\n  class SensoreTelemetria {\n    - livelloRiempimento: double\n    - livelloBatteria: double\n    - ultimoAggiornamento: DateTime\n    + checkFaultTolerance(): boolean\n  }\n  \n  class PercorsoOttimizzato {\n    - distanzaKm: double\n    - tempoMin: int\n  }\n  \n  class NotificaPush {\n    - testo: String\n  }\n  class CalendarioRaccolta {\n    - data: Date\n    - zona: String\n  }\n  class Rifiuto {\n    - nome: String\n  }\n}\n\n&#39; --- EXTERNAL INTERFACES ---\npackage \&quot;External Interfaces\&quot; {\n  interface ISpidCIEAPI {\n    + verificaToken(token: String): boolean\n  }\n  interface IGoogleMapsAPI {\n    + optimizeRoute(waypoints: List): JsonRoute\n  }\n}\n\n&#39; --- RELAZIONI ARCHITETTURALI ---\nAuthController ..&gt; AuthService\nSegnalazioneController ..&gt; SegnalazioneService\nRoutingController ..&gt; RoutingService\nNotificaController ..&gt; NotificaService\n\nAuthService ..&gt; ISpidCIEAPI\nRoutingService ..&gt; IGoogleMapsAPI\nSegnalazioneService ..&gt; IAPrivacyService\n\n&#39; --- RELAZIONI DI DOMINIO E USO ---\nUtente &lt;|-- Cittadino\nUtente &lt;|-- OperatoreEcologico\n\nAuthService ..&gt; Utente : restituisce &gt;\nSegnalazioneService \&quot;1\&quot; --&gt; \&quot;*\&quot; Segnalazione : gestisce &gt;\nIAPrivacyService ..&gt; Foto : elabora &gt;\nRoutingService ..&gt; Cassonetto : legge &gt;\nNotificaService ..&gt; NotificaPush : genera &gt;\nNotificaService ..&gt; CalendarioRaccolta : interroga &gt;\n\nSegnalazione \&quot;1\&quot; *-- \&quot;1\&quot; Foto : contiene &gt;\nCittadino \&quot;1\&quot; -- \&quot;*\&quot; Segnalazione : crea &gt;\nOperatoreEcologico \&quot;1\&quot; -- \&quot;*\&quot; Segnalazione : lavora &gt;\nOperatoreEcologico \&quot;1\&quot; -- \&quot;*\&quot; PercorsoOttimizzato : richiede &gt;\nOperatoreEcologico \&quot;1\&quot; -- \&quot;*\&quot; NotificaPush : genera &gt;\n\nCassonetto \&quot;1\&quot; *-- \&quot;1\&quot; SensoreTelemetria : monta &gt;\n\n&#39; --- COLLEGAMENTI ENUMS ---\nCassonetto \&quot;*\&quot; -up- \&quot;1\&quot; TipoRifiuto\nRifiuto \&quot;*\&quot; -up- \&quot;1\&quot; TipoRifiuto\nCalendarioRaccolta \&quot;*\&quot; -up- \&quot;1\&quot; TipoRifiuto\nSegnalazione \&quot;*\&quot; -left- \&quot;1\&quot; StatoSegnalazione\nNotificaPush \&quot;*\&quot; -up- \&quot;1\&quot; TipoNotifica\n\nPercorsoOttimizzato \&quot;1\&quot; -- \&quot;*\&quot; Cassonetto : svuota &gt;\nPercorsoOttimizzato \&quot;1\&quot; -- \&quot;*\&quot; Segnalazione : risolve &gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ydhNUJnE49P6Dbm4V3-C-214">
